<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ledgerbook.app"
    android:versionCode="8"
    android:versionName="1.7.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!--
          真正的入口 Activity：自身不再声明 LAUNCHER intent-filter，
          桌面图标由下面一组 activity-alias 提供。
          这样应用就能在设置里切换桌面图标（按需启用其中一个别名）。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- 1. Q版鲸鱼娘 · 深海蓝（默认启用） -->
        <activity-alias
            android:name=".LauncherWhaleQBlue"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 2. Q版鲸鱼娘 · 樱花粉 -->
        <activity-alias
            android:name=".LauncherWhaleQPink"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pink"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_pink_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 3. Q版鲸鱼娘 · 清透白 -->
        <activity-alias
            android:name=".LauncherWhaleQLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 4. Q版鲸鱼娘 · 表情包（面部特写） -->
        <activity-alias
            android:name=".LauncherWhaleQFace"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_face"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_face_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 5. 鲸鱼娘 · 成熟版 -->
        <activity-alias
            android:name=".LauncherWhaleMature"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mature"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_mature_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 7. 大肥鱼表情包（透明背景） -->
        <activity-alias
            android:name=".LauncherFish"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fish"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_fish_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 6. 经典柱状图 -->
        <activity-alias
            android:name=".LauncherClassic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_classic_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          自动记账：监听微信 / 支付宝的收付款通知。
          需要在系统「通知使用权」里手动授权后才会收到回调。
          微信与支付宝均无公开的账单读取接口，这是唯一可行的官方途径。
        -->
        <service
            android:name=".PayListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
